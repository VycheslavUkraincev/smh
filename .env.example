# Environment Variables for SaveMyHistory
# Сохранить как secrets в DO App Platform: smh-worker

# --- GPU Worker ---
INTAKE_ONLY=1
GEN_PROVIDER=api           # api → gpu когда RunPod endpoint готов
GEN_MIN_BATCH=0
LOOP_INTERVAL=120

# --- Supabase ---
SUPABASE_URL=https://dvjpfabqkhtcjlqlvuhr.supabase.co

# --- DO Spaces ---
SPACES_REGION=fra1
SPACES_BUCKET=smh-photos

# --- RunPod (на будущее) ---
# RUNPOD_ENDPOINT=https://api.runpod.io/v2/<endpoint_id>/runsync
# Почта Артемия: artemii.shakola@stud.vilniustech.lt
# Startup Program: см. runpod.io/startup-program

# --- Флоу ---
# Сейчас: intake_only=1 → фото накапливаются, ИИ-глаза анализируют без GPU
# Когда RunPod появится:
#   INTAKE_ONLY=0
#   GEN_PROVIDER=gpu
#   добавить RUNPOD_ENDPOINT + RUNPOD_KEY
