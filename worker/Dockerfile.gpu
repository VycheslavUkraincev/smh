# =============================================================================
# LEGACY IMAGE — Real-ESRGAN + CodeFormer (NOT commercial Path A default)
# =============================================================================
# SaveMyHistory — GPU образ для RunPod Serverless (реставрация фото)
#
# !!! LEGACY BANNER (D4) !!!
#   THIS FILE = demo/R&D stack only: Real-ESRGAN + CodeFormer.
#   Commercial Path A draft lives in sibling: Dockerfile.gpu.patha
#     (LaMa → GFPGAN|RestoreFormer++ → Real-ESRGAN → DDColor).
#   CodeFormer ≠ commercial overnight default until license OK.
#   Do NOT treat this image as paid Path A. GEN_STACK defaults to legacy.
#
# Path A prep (no GPU rent in docs-only / stub sessions):
#   - worker/path_a_pipeline.py  — stages, weight URLs, ENV
#   - worker/Dockerfile.gpu.patha — draft install + weight fetch
#   - runpod_handler.py GEN_STACK=path_a|legacy (default legacy until smoke)
#   - GPU smoke ONLY after Roman «GPU да» + $cap + funded account
#
# CUDA 12.1, torch 2.x.
# Сборка LEGACY:  docker build -f Dockerfile.gpu -t smh-gpu .
# Сборка Path A:  docker build -f Dockerfile.gpu.patha -t smh-gpu-patha .
# Пуш:     docker tag … <registry>/… && docker push …
# В RunPod: указать образ в Serverless endpoint, handler = runpod_handler.py

FROM runpod/pytorch:2.1.0-py3.10-cuda12.1.1-devel-ubuntu22.04

WORKDIR /app

# системные либы для opencv
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 wget && rm -rf /var/lib/apt/lists/*

# python-зависимости
RUN pip install --no-cache-dir \
    runpod \
    opencv-python-headless \
    numpy \
    realesrgan \
    basicsr \
    facexlib \
    codeformer-pip \
    torchvision

# скачать веса при сборке (чтобы не тянуть на каждом холодном старте)
ENV WEIGHTS_DIR=/weights
RUN mkdir -p /weights && \
    wget -q -O /weights/RealESRGAN_x2plus.pth \
      https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.1/RealESRGAN_x2plus.pth && \
    wget -q -O /weights/codeformer.pth \
      https://github.com/sczhou/CodeFormer/releases/download/v0.1.0/codeformer.pth

# код хендлера
COPY runpod_handler.py /app/runpod_handler.py

# RunPod запускает этот файл как serverless worker
CMD ["python", "-u", "runpod_handler.py"]
